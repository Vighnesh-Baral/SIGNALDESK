# Local Ollama service. Do not expose Ollama's port publicly.
# Conservative 6 GB VRAM defaults; adaptive retries lower context further on CUDA/KV-cache OOM.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_BATCH_SIZE=5
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_BATCH=128
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=5m

# Set a long random value before exposing the FastAPI service publicly.
# Example PowerShell: python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNALDESK_API_TOKEN=

# Set this to the public HTTPS URL that Nonilion can reach after tunnelling/deployment.
# Example: PUBLIC_BASE_URL=https://your-public-host.example
PUBLIC_BASE_URL=
MAX_UPLOAD_MB=20

# Local-only convenience. Public mode requires SIGNALDESK_API_TOKEN.
ALLOW_UNAUTHENTICATED_LOCAL=true

# Optional local embedding model for semantic clustering. Leave blank to use a CPU-only
# character n-gram TF-IDF similarity fallback (not a deep semantic embedding).
# Example: OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_MODEL=
SIMILARITY_THRESHOLD=0.62
OLLAMA_EMBED_SIMILARITY_THRESHOLD=0.78
CLUSTERING_MAX_RECORDS=2500
PDF_OCR_ENABLED=true

# Optional product workflow integrations. Configure only the providers you use.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
LINEAR_API_KEY=
LINEAR_TEAM_ID=
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
NOTION_VERSION=2022-06-28
