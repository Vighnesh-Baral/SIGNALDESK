# -----------------------------------------------------------------------------
# SIGNALDESK v1.3 - local development defaults
# Copy to .env. Never commit .env or put real credentials in this file.
# -----------------------------------------------------------------------------

# LLM inference: ollama (local), groq, openrouter, or openai_compatible.
# Hosted providers need LLM_API_KEY and LLM_MODEL.
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
# Optional OpenRouter app attribution headers.
LLM_SITE_URL=
LLM_SITE_NAME=SIGNALDESK
# Optional single fallback provider. Configure both its API key and model.
# Example: Groq primary + OpenRouter fallback.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=

# Local Ollama. Do not expose this port publicly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_BATCH_SIZE=5
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_BATCH=128
OLLAMA_NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=5m

# Storage. On Render, attach a Persistent Disk at /var/data and set this root.
# Locally, the default is the project folder.
SIGNALDESK_STORAGE_ROOT=
SIGNALDESK_UPLOAD_DIR=
SIGNALDESK_OUTPUT_DIR=
SIGNALDESK_PROCESSED_DIR=
SIGNALDESK_TEMP_DIR=
# Original uploads contain customer content. Set false if retaining source files is not required.
RETAIN_SOURCE_UPLOADS=true
SOURCE_UPLOAD_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=90
TEMP_RETENTION_HOURS=24
MAX_UPLOAD_MB=20
PDF_OCR_ENABLED=true

# Database. Blank uses local SQLite at data/signaldesk.db.
# Hosted deployment: use the Supabase PostgreSQL connection string.
DATABASE_URL=
DATABASE_REQUIRED=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Security and public URLs.
# Localhost-only unauthenticated mode is enabled by default for development.
# Set false and configure SIGNALDESK_API_TOKEN before public exposure.
SIGNALDESK_API_TOKEN=
PUBLIC_BASE_URL=
ALLOW_UNAUTHENTICATED_LOCAL=true

# Optional local embedding model for clustering. TF-IDF is used when blank.
OLLAMA_EMBED_MODEL=
SIMILARITY_THRESHOLD=0.62
OLLAMA_EMBED_SIMILARITY_THRESHOLD=0.78
CLUSTERING_MAX_RECORDS=2500

# Optional product workflow integrations.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
LINEAR_API_KEY=
LINEAR_TEAM_ID=
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
NOTION_VERSION=2022-06-28
